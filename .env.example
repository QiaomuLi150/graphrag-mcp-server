# Copy to .env for LOCAL development only. Never commit real values. See docs/RUNBOOK.md.
# --- local Neo4j container (docker-compose.yml) ---
NEO4J_ADMIN_PASSWORD=change-me-local-only
NEO4J_ACCEPT_LICENSE_AGREEMENT=eval          # Neo4j Enterprise evaluation licence (local dev only)
# --- seeder (privileged; never present in the serving container) ---
GRAPHRAG_SEED_URI=bolt://127.0.0.1:27687
GRAPHRAG_SEED_USER=neo4j
GRAPHRAG_SEED_PASSWORD=change-me-local-only
GRAPHRAG_SEED_DATABASE=demo
GRAPHRAG_READER_PASSWORD=change-me-too
# --- server (read-only principal) ---
GRAPHRAG_NEO4J_URI=bolt://127.0.0.1:27687
GRAPHRAG_NEO4J_USER=graphrag_reader
GRAPHRAG_NEO4J_PASSWORD=change-me-too
GRAPHRAG_NEO4J_DATABASE=demo
GRAPHRAG_AUTH_ISSUER=https://dev-issuer.local
GRAPHRAG_AUTH_AUDIENCE=graphrag-mcp-local
# one of: GRAPHRAG_AUTH_PUBLIC_KEY (PEM; local) or GRAPHRAG_AUTH_JWKS_URI (OIDC/Google)
# GRAPHRAG_AUTH_PUBLIC_KEY=
